# Copy this file to .env for local development (do not commit .env), or set
# these as environment variables in your hosting provider's dashboard.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# "True" only for local development. Must be "False" in production.
DEBUG=True

# Comma-separated list of hostnames this API is allowed to serve, e.g.
# ALLOWED_HOSTS=safaris-api.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of frontend origins allowed to call this API from
# the browser. Must be exact origins (scheme + host), no trailing slash.
CORS_ALLOWED_ORIGINS=https://judekioko.github.io

# Provided automatically by most hosts (Render, Railway, ...) once you
# attach a Postgres database. Leave unset to use local SQLite.
# DATABASE_URL=postgres://user:password@host:5432/dbname
